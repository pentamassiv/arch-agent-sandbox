
FROM quay.io/archlinux/archlinux:latest

# Install system packages.
RUN pacman -Syu --needed --noconfirm \
    base-devel \
    sudo \
    git \
    git-lfs \
    openssh \
    curl \
    wget \
    jq \
    ripgrep \
    fd \
    file \
    less \
    tmux \
    fzf \
    unzip \
    zip \
    xz \
    ca-certificates \
    pkgconf \
    cmake \
    ninja \
    clang \
    lld \
    gdb \
    python \
    python-pip \
    nodejs \
    npm \
    openssl \
    gtk4 \
    libadwaita \
    glib2 \
    rustup \
    && pacman -Scc --noconfirm

# Create the development user.
RUN useradd \
    --create-home \
    --uid 1000 \
    --shell /bin/bash \
    dev

# Passwordless sudo, restricted to this container.
RUN printf '%s\n' \
    'dev ALL=(ALL:ALL) NOPASSWD: ALL' \
    > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev \
    && visudo -cf /etc/sudoers.d/dev

USER dev

ENV HOME=/home/dev
ENV CARGO_HOME=/home/dev/.cargo
ENV RUSTUP_HOME=/home/dev/.rustup
ENV PATH=/home/dev/.cargo/bin:${PATH}

# Install Rust stable and nightly.
RUN rustup toolchain install stable \
        --profile minimal \
        --component rustfmt \
        --component clippy \
        --component rust-analyzer \
    && rustup toolchain install nightly \
        --profile minimal \
        --component rustfmt \
        --component clippy \
    && rustup default stable

WORKDIR /workspace
